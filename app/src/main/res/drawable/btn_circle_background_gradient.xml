<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Diagonal gradient from WhatsApp accent green to primary green -->
    <gradient
        android:startColor="@color/accentColor"
    android:endColor="@color/primaryColor"
    android:angle="45"
    android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="24dp"/>

    <!-- Subtle dark stroke -->
    <stroke
        android:width="2dp"
        android:color="@color/primaryDark"/>      <!-- #128C7E -->

</shape>
